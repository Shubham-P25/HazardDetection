# ---------- Server ----------
PORT=4000
# Comma separated list of allowed dashboard URLs
FRONTEND_ORIGIN=http://localhost:3000
# Secret used by devices / scripts that POST to the backend. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_API_KEY=CHANGE_ME

# ---------- Postgres (REQUIRED) ----------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ---------- InfluxDB (optional but recommended) ----------
INFLUX_URL=https://YOUR_REGION.gcp.influxdata.com
INFLUX_TOKEN=YOUR_INFLUX_TOKEN
INFLUX_ORG=YOUR_INFLUX_ORG
INFLUX_BUCKET=hazard-sensors

# ---------- MQTT (live ESP data) ----------
MQTT_ENABLED=true
MQTT_BROKER=mqtt://broker.hivemq.com
# MQTT_TOPIC_PREFIX sets a unique namespace on a public broker.
# Final topic will be <prefix>/sensors  e.g. hazardguard/abc123/sensors
# Set the same prefix in NodeMCU firmware.
MQTT_TOPIC_PREFIX=hazardguard/CHANGE_ME_unique_id
# MQTT_TOPIC overrides the topic entirely (takes precedence over prefix)
# MQTT_TOPIC=hazardguard/CHANGE_ME_unique_id/sensors
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------- Default device ----------
DEFAULT_DEVICE_ID=node-1

# ---------- Sensor behaviour ----------
FLAME_ACTIVE_LOW=false
RAIN_ACTIVE_LOW=false
# Mark sensor offline if no reading for this long (ms)
STALE_AFTER_MS=10000

# ---------- MQ-2 calibration ----------
# Run  node scripts/calibrate-mq2.js  in clean air after 20 min warm-up
MQ2_R0=10
MQ2_RL=5
MQ2_VC=5

# ---------- Simulator ----------
# Set SIMULATOR=true to publish synthetic readings every 2 s
SIMULATOR=false
# Send real Email/Telegram for simulated incidents? (default: false)
SIMULATOR_SEND_ALERTS=false

# ---------- Incidents ----------
# Auto-resolve open incidents after this many ms (default: 60000)
INCIDENT_AUTORESOLVE_MS=60000

# ---------- ML service ----------
ML_SERVICE_URL=http://localhost:8000

# ---------- Clerk auth (optional; if omitted, all endpoints are open) ----------
CLERK_SECRET_KEY=sk_live_CHANGE_ME
CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME
# Claim path in the session token (see README - Clerk setup)
CLERK_ROLE_CLAIM=metadata.role

# ---------- Alerts (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Gmail: 2-Step Verification ON + 16-char App Password (no spaces)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=
# Email to share exported Sheets with (when no GOOGLE_SHEETS_ID)
EXPORT_SHARE_EMAIL=

# ---------- Google Sheets export ----------
# If set, exports append a new tab to this existing sheet (share the sheet with the service account email as Editor)
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Sheet1
# Defaults to backend/google-credentials.json
GOOGLE_CREDENTIALS_PATH=

# ---------- ThingSpeak (optional) ----------
THINGSPEAK_WRITE_KEY=
